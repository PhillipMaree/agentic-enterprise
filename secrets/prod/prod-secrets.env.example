# Production secret values used ONLY to seal SealedSecrets (scripts/seal-prod-secrets.sh).
#
# Copy this OUT of the repo, fill in real values, source it, seal, then forget it:
#
#   cp secrets/prod/prod-secrets.env.example ~/.agentic-enterprise-prod.env
#   $EDITOR ~/.agentic-enterprise-prod.env        # fill every <PLACEHOLDER>
#   set -a; source ~/.agentic-enterprise-prod.env; set +a
#   scripts/seal-prod-secrets.sh                   # writes deploy/sealed-secrets/prod/*.sealedsecret.yaml
#   git add deploy/sealed-secrets/prod/*.sealedsecret.yaml   # encrypted output only
#
# NEVER commit a filled-in copy. Real values stay in your shell/profile, never in git.
# (*.env is gitignored; only this *.example is tracked.)

# --- Postgres → agentic-enterprise-postgres ---
export POSTGRES_USER='postgres'
export POSTGRES_PASSWORD='<POSTGRES_PASSWORD>'
export POSTGRES_DB='mlflow'                       # shared DB; litellm's DB is created separately

# --- Keycloak admin → agentic-enterprise-keycloak-admin ---
export KEYCLOAK_ADMIN_USERNAME='admin'
export KEYCLOAK_ADMIN_PASSWORD='<KEYCLOAK_ADMIN_PASSWORD>'

# --- Grafana admin → agentic-enterprise-grafana-admin ---
export GRAFANA_ADMIN_USER='admin'
export GRAFANA_ADMIN_PASSWORD='<GRAFANA_ADMIN_PASSWORD>'

# --- LiteLLM → agentic-enterprise-litellm-secrets ---
export LITELLM_MASTER_KEY='<LITELLM_MASTER_KEY>'  # bearer token clients send to the proxy, e.g. sk-...
# ANTHROPIC_API_KEY / OPENAI_API_KEY are NOT set here — keep them in your own
# shell/profile. seal-prod-secrets.sh reads them from the environment and aborts
# if they're missing.

# --- SeaweedFS S3 → agentic-enterprise-s3-creds ---
export S3_ACCESS_KEY_ID='<S3_ACCESS_KEY_ID>'
export S3_SECRET_ACCESS_KEY='<S3_SECRET_ACCESS_KEY>'
export S3_REGION='us-east-1'
export S3_ENDPOINT_URL='http://agentic-enterprise-seaweedfs-all-in-one:8333'   # in-cluster S3 endpoint
# Path to the SeaweedFS S3 identities JSON (its access/secret keys must match the
# AWS_* values above). Shape: see config/seaweedfs/s3-identities.json.
export S3_IDENTITIES_FILE="$HOME/agentic-enterprise-prod-s3-identities.json"
