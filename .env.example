# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# Every variable here has a dev-only default in docker-compose.yaml, so the
# stack runs out-of-the-box if `.env` is missing or empty. Override anything
# you don't want to ship as a default into a shared environment.
#
# Defaults are clearly insecure (`admin`, `password`, `any`) — do not deploy
# this stack anywhere shared without setting real values.
#
# Some credentials moved to file-based Compose secrets (see secrets/compose/
# and docs/SECURITY.md): the Postgres SERVER password, the Keycloak admin
# password, and the Grafana admin password are read from files, not env.

# --- Postgres (shared by litellm + mlflow) --------------------------------
# The server reads its password from secrets/compose/postgres_password. This
# var is still needed because litellm/mlflow/postgres-init build connection
# strings from it — keep it in sync with that file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mlflow

# --- SeaweedFS S3 (used by mlflow, tempo, loki) ---------------------------
# These must match the identities in config/seaweedfs/s3-identities.json.
# If you change them here, update that file too.
S3_ACCESS_KEY=any
S3_SECRET_KEY=any

# --- LiteLLM --------------------------------------------------------------
# Master API key — clients pass this as `Authorization: Bearer <key>`.
# Must be >=32 chars. Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-dev-master-key-change-me-not-a-secret

# Admin UI credentials (http://localhost:14000/ui)
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=password

# --- Keycloak / Grafana admin passwords -----------------------------------
# File-based secrets, NOT env. Set them in:
#   secrets/compose/keycloak_admin_password
#   secrets/compose/grafana_admin_password
# (copy the committed *.example files to bootstrap). Username defaults stay
# in docker-compose.yaml.

# --- LLM providers (optional; leave blank for models you don't use) ------
# Local Compose only. These never enter the kind/dev cluster (mock-only) and
# are never committed. See docs/SECURITY.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
