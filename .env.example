# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# Every variable here has a dev-only default in docker-compose.yaml, so the
# stack runs out-of-the-box if `.env` is missing or empty. Override anything
# you don't want to ship as a default into a shared environment.
#
# Defaults are clearly insecure (`admin`, `password`, `any`) — do not deploy
# this stack anywhere shared without setting real values.

# --- Postgres (shared by litellm + mlflow) --------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mlflow

# --- SeaweedFS S3 (used by mlflow, tempo, loki) ---------------------------
# These must match the identities in config/seaweedfs/s3-identities.json.
# If you change them here, update that file too.
S3_ACCESS_KEY=any
S3_SECRET_KEY=any

# --- LiteLLM --------------------------------------------------------------
# Master API key — clients pass this as `Authorization: Bearer <key>`.
# Must be >=32 chars. Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-dev-master-key-change-me-not-a-secret

# Admin UI credentials (http://localhost:4000/ui)
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=password

# --- Grafana --------------------------------------------------------------
# Admin password for http://localhost:3001 (user: admin)
GRAFANA_ADMIN_PASSWORD=admin

# --- LLM providers (optional; leave blank for models you don't use) ------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
